root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.swift]
indent_size = 4

[*.pbxproj]
indent_style = tab
indent_size = tab

[*.md]
trim_trailing_whitespace = false

# Preserve the formatting of test inputs and expected outputs.
[test/fixtures/**]
end_of_line = unset
indent_style = unset
indent_size = unset
insert_final_newline = unset
trim_trailing_whitespace = false
